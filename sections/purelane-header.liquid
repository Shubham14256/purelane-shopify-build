<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

#shopify-section-{{ section.id }} {
  --ink:#f4f0fb;
  --brand:#4b3a8f;
  --paper:#241a3d;                        
  --paper-2:rgba(36,26,61,.78);
  --paper-3:rgba(36,26,61,.56);
  --accent:#b8701c;                        
  --accent-2:#c9761d;
  --surface:#17102b;                        
  --g-bg:linear-gradient(158deg,rgba(255,255,255,.80),rgba(236,230,247,.56) 58%,rgba(222,212,240,.50));
  --g-line:rgba(75,58,143,.16);
  --g-shadow:0 22px 54px rgba(58,44,112,.13);
  --g-inset:inset 0 1px 0 rgba(255,255,255,.92);
  --r:26px;
  --maxw:1180px;
  --ease:cubic-bezier(.2,.7,.2,1);

  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

#shopify-section-{{ section.id }} * { box-sizing:border-box; margin:0; padding:0; }
#shopify-section-{{ section.id }} a { color:inherit; text-decoration:none; }
#shopify-section-{{ section.id }} button { font-family:inherit; cursor:pointer; border:none; background:none; color:inherit; }

/* GLASS EFFECT */
#shopify-section-{{ section.id }} .glass { background:var(--g-bg); backdrop-filter:blur(24px) saturate(150%); -webkit-backdrop-filter:blur(24px) saturate(150%); border:1px solid var(--g-line); border-radius:var(--r); box-shadow:var(--g-shadow),var(--g-inset); position:relative; overflow:hidden; }
#shopify-section-{{ section.id }} .glass::after { content:""; position:absolute; inset:0; pointer-events:none; border-radius:inherit; background:linear-gradient(115deg,rgba(255,255,255,.55),transparent 32%,transparent 74%,rgba(201,118,29,.06)); }

/* NAV STRUCTURE */
#shopify-section-{{ section.id }} header { position:fixed; top:38px; left:0; right:0; z-index:50; padding:0 14px; transition:top .4s var(--ease); }
#shopify-section-{{ section.id }} header.up { top:10px; }
#shopify-section-{{ section.id }} .navpill { max-width:var(--maxw); margin:0 auto; display:flex; align-items:center; gap:18px; padding:10px 14px; border-radius:999px; }

/* BRAND */
#shopify-section-{{ section.id }} .brand { display:flex; align-items:center; gap:11px; flex:0 0 auto; position:relative; z-index:2; }
#shopify-section-{{ section.id }} .brand .mark { width:40px; height:40px; border-radius:50%; display:grid; place-items:center; flex:0 0 auto; background:linear-gradient(150deg,rgba(201,118,29,.20),rgba(75,58,143,.14)); border:1px solid rgba(75,58,143,.18); }
#shopify-section-{{ section.id }} .brand .mark svg { width:23px; height:23px; color:#b8701c !important; }
#shopify-section-{{ section.id }} .brand .txt { line-height:1.05; }
#shopify-section-{{ section.id }} .brand .n1 { display:block; font-family:'Outfit',sans-serif; font-weight:800; font-size:16.5px; line-height:1.06; letter-spacing:.02em; text-transform:uppercase; color:var(--surface); }
#shopify-section-{{ section.id }} .brand .n2 { display:block; font-size:8.5px; font-weight:600; line-height:1.3; letter-spacing:.28em; text-transform:uppercase; color:var(--paper-3); }

/* LINKS */
#shopify-section-{{ section.id }} .nav { display:none; gap:26px; margin:0 auto; font-size:13.5px; font-weight:500; position:relative; z-index:2; }
#shopify-section-{{ section.id }} .nav a { color:var(--paper-2); padding:6px 0; position:relative; transition:.3s; }
#shopify-section-{{ section.id }} .nav a::after { content:""; position:absolute; left:0; right:100%; bottom:0; height:1.5px; background:#b8701c; transition:right .35s var(--ease); }
#shopify-section-{{ section.id }} .nav a:hover { color:var(--surface); }
#shopify-section-{{ section.id }} .nav a:hover::after { right:0; }

/* TOOLS */
#shopify-section-{{ section.id }} .navtools { display:flex; align-items:center; gap:4px; margin-left:auto; position:relative; z-index:2; }
#shopify-section-{{ section.id }} .ico { width:38px; height:38px; border-radius:50%; display:grid; place-items:center; color:var(--paper-2); transition:.3s; position:relative; }
#shopify-section-{{ section.id }} .ico:hover { background:rgba(75,58,143,.09); color:var(--surface); }
#shopify-section-{{ section.id }} .ico svg { width:18px; height:18px; }
#shopify-section-{{ section.id }} .dot { position:absolute; top:5px; right:5px; min-width:16px; height:16px; border-radius:999px; background:#4b3a8f; color:#f4fdf6; font-size:9.5px; font-weight:800; display:grid; place-items:center; padding:0 4px; }
#shopify-section-{{ section.id }} .burger { display:grid; }

@media(max-width:600px){
  #shopify-section-{{ section.id }} .ico.hide-s { display:none; }
  #shopify-section-{{ section.id }} .brand .mark { width:34px; height:34px; }
  #shopify-section-{{ section.id }} .brand .n1 { font-size:14.5px; }
  #shopify-section-{{ section.id }} .brand .n2 { font-size:7.6px; letter-spacing:.2em; }
  #shopify-section-{{ section.id }} .navpill { gap:10px; padding:8px 10px; }
}
@media(min-width:1024px){
  #shopify-section-{{ section.id }} .nav { display:flex; }
  #shopify-section-{{ section.id }} .burger { display:none; }
}
</style>

<header id="hdr-{{ section.id }}">
  <div class="navpill glass">
    <a class="brand" href="/" aria-label="{{ section.settings.brand_name }}">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
        </svg>
      </span>
      <span class="txt">
        <span class="n1">{{ section.settings.brand_name }}</span>
        <span class="n2">{{ section.settings.brand_slogan }}</span>
      </span>
    </a>
    
    <nav class="nav" aria-label="Main">
      {%- if section.settings.use_original_nav -%}
        <a href="#top">Home</a>
        <a href="#ingredients">Ingredients</a>
        <a href="#how">How it works</a>
        <a href="#shop">Shop</a>
        <a href="#bundles">Bundles</a>
      {%- else -%}
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {%- endif -%}
    </nav>

    <div class="navtools">
      <button class="ico hide-s" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      <button class="ico hide-s" aria-label="Account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg></button>
      <!-- DYNAMIC CART ITEM COUNT -->
      <a class="ico" href="/cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg>
        <span class="dot">{{ cart.item_count }}</span>
      </a>
      <button class="ico burger" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg></button>
    </div>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var hdr = document.getElementById('hdr-{{ section.id }}');
    window.addEventListener('scroll', function() {
      var y = window.scrollY || window.pageYOffset;
      if (hdr) hdr.classList.toggle('up', y > 90);
    }, { passive: true });
  });
</script>

{% schema %}
{
  "name": "Purelane Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "brand_slogan",
      "label": "Brand Slogan",
      "default": "Clean, simply"
    },
    {
      "type": "checkbox",
      "id": "use_original_nav",
      "label": "Use Original Hardcoded Links",
      "default": true,
      "info": "Leave checked to show Home, Ingredients, How it works, Shop, Bundles."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Dynamic Navigation Menu",
      "info": "Uncheck the box above to use this Shopify menu instead."
    }
  ],
  "presets": [
    {
      "name": "Purelane Header"
    }
  ]
}
{% endschema %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

/* Scope all styles to this section so Dawn theme doesn't break it */
#shopify-section-{{ section.id }} {
  --ink:#f4f0fb;
  --deep:#e2daf3;
  --brand:#4b3a8f;
  --brand-lt:#6b55b8;
  --paper:#241a3d;                        
  --paper-2:rgba(36,26,61,.78);
  --paper-3:rgba(36,26,61,.56);
  --accent:#b8701c;                        
  --accent-2:#c9761d;
  --surface:#17102b;                        
  --g-bg:linear-gradient(158deg,rgba(255,255,255,.80),rgba(236,230,247,.56) 58%,rgba(222,212,240,.50));
  --g-line:rgba(75,58,143,.16);
  --g-shadow:0 22px 54px rgba(58,44,112,.13);
  --g-inset:inset 0 1px 0 rgba(255,255,255,.92);
  --r:26px;
  --sec-y:34px;
  --maxw:1180px;
  --ease:cubic-bezier(.2,.7,.2,1);

  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  color: var(--paper);
  line-height: 1.62;
  -webkit-font-smoothing: antialiased;
}

#shopify-section-{{ section.id }} * { box-sizing:border-box; margin:0; padding:0; }
#shopify-section-{{ section.id }} a { color:inherit; text-decoration:none; }
#shopify-section-{{ section.id }} button { font-family:inherit; cursor:pointer; border:none; background:none; color:inherit; }

/* TYPE */
#shopify-section-{{ section.id }} .d1, #shopify-section-{{ section.id }} .d2 { font-family:'Outfit',system-ui,sans-serif; text-transform:uppercase; letter-spacing:-.018em; font-weight:800; color:var(--surface); }
#shopify-section-{{ section.id }} .d1 { font-size:clamp(48px,8.6vw,112px); line-height:.87; }
#shopify-section-{{ section.id }} .lime { color:var(--accent); }
#shopify-section-{{ section.id }} .lede { font-size:clamp(15px,1.35vw,17.5px); color:var(--paper-2); max-width:44ch; }

/* SCENES & BACKGROUND */
#shopify-section-{{ section.id }} .scenes { position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; background:#eee7fb; }
#shopify-section-{{ section.id }} .scene { position:absolute; inset:0; opacity:0; transition:opacity 1.5s ease; }
#shopify-section-{{ section.id }} .scene.on { opacity:1; }
#shopify-section-{{ section.id }} .s1 { background:linear-gradient(178deg,#fbfffb 0%,#eafaec 24%,#d6f1dc 54%,#bfe8ca 100%); }

#shopify-section-{{ section.id }} .water { position:absolute; inset:-14% -10%; pointer-events:none; transition:opacity 1.2s ease; }
#shopify-section-{{ section.id }} .wl { position:absolute; inset:0; will-change:transform; translate:var(--px,0) var(--py,0); }
#shopify-section-{{ section.id }} .wl .sv { width:100%; height:100%; }
#shopify-section-{{ section.id }} .wl-a { mix-blend-mode:soft-light; opacity:1; animation:drift-a 34s linear infinite; }
#shopify-section-{{ section.id }} .wl-a .sv { filter:contrast(1.25); }
#shopify-section-{{ section.id }} .vig { position:absolute; inset:0; pointer-events:none; background:radial-gradient(126% 88% at 50% 26%,transparent 42%,rgba(75,58,143,.07) 80%,rgba(0,80,74,.16) 100%), linear-gradient(180deg,rgba(255,255,255,.40) 0%,transparent 20%,transparent 70%,rgba(0,84,78,.10) 100%); }

@keyframes drift-a {
  0%{transform:translate3d(-3%,0,0) scale(1.06)}
  50%{transform:translate3d(3%,-1.6%,0) scale(1.13)}
  100%{transform:translate3d(-3%,0,0) scale(1.06)}
}

/* GLASS & BUTTONS */
#shopify-section-{{ section.id }} .glass-2 { background:linear-gradient(158deg,rgba(255,255,255,.66),rgba(236,230,247,.44)); backdrop-filter:blur(18px) saturate(135%); -webkit-backdrop-filter:blur(18px) saturate(135%); border:1px solid rgba(75,58,143,.13); border-radius:var(--r); box-shadow:0 16px 38px rgba(58,44,112,.10),inset 0 1px 0 rgba(255,255,255,.86); position:relative; overflow:hidden; }
#shopify-section-{{ section.id }} .btn { display:inline-flex; align-items:center; gap:10px; height:46px; padding:0 22px; border-radius:999px; font-size:12.5px; font-weight:700; letter-spacing:.13em; text-transform:uppercase; transition:.35s var(--ease); white-space:nowrap; }
#shopify-section-{{ section.id }} .btn-primary { background:linear-gradient(135deg,#00706a,#004b46); color:#f4fdf6; box-shadow:0 12px 26px rgba(0,80,74,.26),inset 0 1px 0 rgba(255,255,255,.22); }
#shopify-section-{{ section.id }} .btn-primary:hover { box-shadow:0 18px 36px rgba(0,80,74,.32),inset 0 1px 0 rgba(255,255,255,.28); transform:translateY(-2px); }
#shopify-section-{{ section.id }} .btn-ghost { background:rgba(255,255,255,.66); border:1px solid rgba(75,58,143,.22); color:#01423b; backdrop-filter:blur(12px); border-radius:999px;}
#shopify-section-{{ section.id }} .btn-ghost:hover { background:rgba(255,255,255,.9); transform:translateY(-2px); }

/* HERO LAYOUT */
#shopify-section-{{ section.id }} .hero { position:relative; z-index:2; min-height:100svh; display:flex; align-items:flex-end; padding:150px 0 var(--sec-y); }
#shopify-section-{{ section.id }} .hero::before { content:""; position:absolute; inset:0; z-index:1; pointer-events:none; background:linear-gradient(102deg,rgba(255,255,255,.80) 0%,rgba(255,255,255,.50) 30%,rgba(255,255,255,.12) 54%,transparent 68%); }
#shopify-section-{{ section.id }} .hero-grid { max-width:var(--maxw); margin:0 auto; padding:0 18px; width:100%; position:relative; z-index:2; }
#shopify-section-{{ section.id }} .hero-copy { max-width:600px; position:relative; z-index:3; }
#shopify-section-{{ section.id }} .hero h1 { margin-bottom:20px; }
#shopify-section-{{ section.id }} .rule { display:flex; align-items:center; gap:13px; margin:0 0 20px; max-width:270px; }
#shopify-section-{{ section.id }} .rule i { height:1px; flex:1; background:linear-gradient(90deg,rgba(75,58,143,.34),transparent); }
#shopify-section-{{ section.id }} .rule svg { width:16px; height:16px; color:var(--accent); flex:0 0 auto; }
#shopify-section-{{ section.id }} .hero-cta { display:flex; gap:11px; flex-wrap:wrap; margin-top:26px; }

/* BADGES */
#shopify-section-{{ section.id }} .badges { position:absolute; right:18px; top:50%; transform:translateY(-50%); width:96px; z-index:4; display:flex; flex-direction:column; gap:2px; padding:12px 8px; border-radius:20px; }
#shopify-section-{{ section.id }} .badge { text-align:center; padding:11px 4px; }
#shopify-section-{{ section.id }} .badge+.badge { border-top:1px solid rgba(75,58,143,.12); }
#shopify-section-{{ section.id }} .badge .bi { width:38px; height:38px; margin:0 auto 8px; border-radius:50%; display:grid; place-items:center; background:rgba(255,255,255,.62); border:1px solid rgba(75,58,143,.16); color:#4f7d10; }
#shopify-section-{{ section.id }} .badge .bi svg { width:19px; height:19px; }
#shopify-section-{{ section.id }} .badge span { display:block; font-size:8.5px; font-weight:700; letter-spacing:.11em; text-transform:uppercase; color:var(--paper-2); line-height:1.34; }
#shopify-section-{{ section.id }} .badgestrip { display:none; }

/* PRODUCTS STAGE */
#shopify-section-{{ section.id }} {
  --p-kbtl:url("data:image/svg+xml;base64,");
  --p-tbtl:url("data:image/svg+xml;base64,");
  --p-mbtl:url("data:image/svg+xml;base64,");
}
#shopify-section-{{ section.id }} .p-kbtl { background-image:var(--p-kbtl); aspect-ratio:0.3229; }
#shopify-section-{{ section.id }} .p-tbtl { background-image:var(--p-tbtl); aspect-ratio:0.322; }
#shopify-section-{{ section.id }} .p-mbtl { background-image:var(--p-mbtl); aspect-ratio:0.3416; }

#shopify-section-{{ section.id }} .hero-prod { position:absolute; right:2%; bottom:28px; width:min(50vw,560px); z-index:2; filter:drop-shadow(0 14px 22px rgba(0,74,66,.15)); }
#shopify-section-{{ section.id }} .hstage { position:relative; width:100%; height:clamp(380px,74svh,680px); }
#shopify-section-{{ section.id }} .hslide { position:absolute; inset:0; display:flex; align-items:flex-end; justify-content:flex-end; padding-right:2%; opacity:0; pointer-events:none; transition:opacity .85s var(--ease); }
#shopify-section-{{ section.id }} .hslide.on { opacity:1; }
#shopify-section-{{ section.id }} .hp { position:relative; width:auto; flex:0 0 auto; background-repeat:no-repeat; background-position:center bottom; background-size:contain; opacity:0; transform:translateY(28px) scale(.94); transition:opacity .8s var(--ease),transform .8s var(--ease); filter:drop-shadow(0 14px 22px rgba(0,74,66,.15)); }
#shopify-section-{{ section.id }} .hslide.on .hp { opacity:1; transform:none; }
#shopify-section-{{ section.id }} .hslide.on .hp.d1 { transition-delay:.06s; }
#shopify-section-{{ section.id }} .hslide.on .hp.d2 { transition-delay:.30s; }
#shopify-section-{{ section.id }} .hslide.on .hp.d3 { transition-delay:.54s; }
#shopify-section-{{ section.id }} .hs1 .a { height:100%; z-index:3; }
#shopify-section-{{ section.id }} .hs2 .a { height:80%; margin-right:-8%; z-index:1; }
#shopify-section-{{ section.id }} .hs2 .b { height:97%; z-index:3; }
#shopify-section-{{ section.id }} .hs3 .a { height:75%; margin-right:-8%; z-index:1; order:1; }
#shopify-section-{{ section.id }} .hs3 .c { height:97%; z-index:3; order:2; }
#shopify-section-{{ section.id }} .hs3 .b { height:79%; margin-left:-8%; z-index:2; order:3; }

#shopify-section-{{ section.id }} .ptag { position:absolute; left:0; bottom:2%; z-index:6; padding:11px 14px 12px; border-radius:16px; max-width:52%; opacity:0; transform:translateY(16px); transition:opacity .8s var(--ease) .62s,transform .8s var(--ease) .62s; }
#shopify-section-{{ section.id }} .hslide.on .ptag { opacity:1; transform:none; }
#shopify-section-{{ section.id }} .ptag .lbl { display:block; font-size:9px; font-weight:800; letter-spacing:.17em; text-transform:uppercase; color:var(--accent); }
#shopify-section-{{ section.id }} .ptag .val { display:flex; align-items:baseline; gap:7px; margin-top:5px; }
#shopify-section-{{ section.id }} .ptag .val strong { font-family:'Outfit',sans-serif; font-size:23px; font-weight:800; letter-spacing:-.02em; color:var(--surface); line-height:1; }
#shopify-section-{{ section.id }} .ptag .val s { font-size:12px; color:var(--paper-3); }
#shopify-section-{{ section.id }} .ptag .cut { display:inline-block; margin-top:7px; font-size:8.4px; font-weight:800; letter-spacing:.11em; text-transform:uppercase; padding:3px 8px; border-radius:999px; background:rgba(201,118,29,.16); border:1px solid rgba(201,118,29,.36); color:#4f7d10; }

#shopify-section-{{ section.id }} .hdots { display:flex; gap:7px; justify-content:center; align-items:center; margin-top:8px; }
#shopify-section-{{ section.id }} .hdots button { width:6px; height:6px; padding:0; border-radius:50%; background:rgba(75,58,143,.22); transition:.4s var(--ease); }
#shopify-section-{{ section.id }} .hdots button.on { background:#b8701c; width:20px; border-radius:999px; }
#shopify-section-{{ section.id }} .hdots button:hover { background:rgba(75,58,143,.4); }

@media(max-width:900px){
  #shopify-section-{{ section.id }} .hero { align-items:flex-end; padding-top:132px; }
  #shopify-section-{{ section.id }} .hero-copy { max-width:none; }
  #shopify-section-{{ section.id }} .hero-prod { position:relative; right:auto; bottom:auto; width:min(88vw,420px); margin:20px auto 0; }
  #shopify-section-{{ section.id }} .badges { display:none; }
  #shopify-section-{{ section.id }} .badgestrip { display:flex; gap:8px; margin-top:24px; }
  #shopify-section-{{ section.id }} .badgestrip div { flex:1; text-align:center; padding:11px 6px; border-radius:14px; font-size:8.5px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--paper-2); line-height:1.3; }
  #shopify-section-{{ section.id }} .badgestrip svg { width:18px; height:18px; margin:0 auto 6px; color:#4f7d10; }
  #shopify-section-{{ section.id }} .hero::before{ background:linear-gradient(180deg,rgba(255,255,255,.62) 0%,rgba(255,255,255,.34) 36%,rgba(255,255,255,.66) 100%); }
}
</style>


<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

#shopify-section-{{ section.id }} {
  --ink:#f4f0fb; --brand:#4b3a8f; --paper:#241a3d; --paper-2:rgba(36,26,61,.78);
  --paper-3:rgba(36,26,61,.56); --accent:#b8701c; --surface:#17102b;
  --sec-y:34px; --maxw:1180px; --ease:cubic-bezier(.2,.7,.2,1);
  --g-bg:linear-gradient(158deg,rgba(255,255,255,.80),rgba(236,230,247,.56) 58%,rgba(222,212,240,.50));
  --g-inset:inset 0 1px 0 rgba(255,255,255,.92);
  font-family: 'Inter', system-ui, -apple-system, sans-serif;

  /* BOTTLE IMAGES */
  --p-dish:url("data:image/svg+xml;base64,");
  --p-eraser:url("data:image/svg+xml;base64,");
  --p-floor:url("data:image/svg+xml;base64,");
  --p-handwash:url("data:image/svg+xml;base64,");
  --p-kitchen:url("data:image/svg+xml;base64,");
  --p-laundry:url("data:image/svg+xml;base64,");
  --p-metal:url("data:image/svg+xml;base64,");
  --p-tap:url("data:image/svg+xml;base64,");
  --p-toilet:url("data:image/svg+xml;base64,");
  --p-wm:url("data:image/svg+xml;base64,");
}

#shopify-section-{{ section.id }} * { box-sizing:border-box; margin:0; padding:0; }
#shopify-section-{{ section.id }} .wrap { max-width:var(--maxw); margin:0 auto; padding:0 18px; }

#shopify-section-{{ section.id }} .sec { position:relative; padding:var(--sec-y) 0; }
#shopify-section-{{ section.id }} .glass { background:var(--g-bg); backdrop-filter:blur(24px) saturate(150%); border:1px solid rgba(75,58,143,.16); border-radius:26px; box-shadow:0 22px 54px rgba(58,44,112,.13), var(--g-inset); position:relative; overflow:hidden; }

#shopify-section-{{ section.id }} .range { padding:clamp(20px,2.6vw,30px); }
#shopify-section-{{ section.id }} .range-head { display:flex; flex-wrap:wrap; align-items:flex-end; gap:14px; justify-content:space-between; margin-bottom:8px; }
#shopify-section-{{ section.id }} .kicker { font-size:11px; font-weight:700; letter-spacing:.22em; text-transform:uppercase; color:var(--paper-3); }
#shopify-section-{{ section.id }} .d2 { font-family:'Outfit',sans-serif; text-transform:uppercase; letter-spacing:-.018em; font-weight:800; font-size:clamp(30px,4.6vw,54px); line-height:.94; color:var(--surface); max-width:20ch; }
#shopify-section-{{ section.id }} .body-s { font-size:14.5px; color:var(--paper-2); line-height:1.66; max-width:34ch; margin-bottom:4px; }

#shopify-section-{{ section.id }} .stripwrap { margin:10px 0 0; }
#shopify-section-{{ section.id }} .rangerow { display:flex; align-items:flex-end; justify-content:space-between; gap:6px; min-height:150px; }

/* SVG Background Class Mapping */
#shopify-section-{{ section.id }} .pimg { display:block; background-repeat:no-repeat; background-position:center bottom; background-size:contain; flex:0 0 auto; height:132px; filter:drop-shadow(0 12px 18px rgba(0,74,66,.14)); }
#shopify-section-{{ section.id }} .rangerow .pimg:nth-child(even) { height:118px; }

#shopify-section-{{ section.id }} .p-dish { background-image:var(--p-dish); aspect-ratio:0.624; }
#shopify-section-{{ section.id }} .p-eraser { background-image:var(--p-eraser); aspect-ratio:1.3187; }
#shopify-section-{{ section.id }} .p-floor { background-image:var(--p-floor); aspect-ratio:0.6312; }
#shopify-section-{{ section.id }} .p-handwash { background-image:var(--p-handwash); aspect-ratio:0.7453; }
#shopify-section-{{ section.id }} .p-kitchen { background-image:var(--p-kitchen); aspect-ratio:0.6387; }
#shopify-section-{{ section.id }} .p-laundry { background-image:var(--p-laundry); aspect-ratio:0.6302; }
#shopify-section-{{ section.id }} .p-metal { background-image:var(--p-metal); aspect-ratio:0.6993; }
#shopify-section-{{ section.id }} .p-tap { background-image:var(--p-tap); aspect-ratio:0.6387; }
#shopify-section-{{ section.id }} .p-toilet { background-image:var(--p-toilet); aspect-ratio:0.6139; }
#shopify-section-{{ section.id }} .p-wm { background-image:var(--p-wm); aspect-ratio:0.6148; }

#shopify-section-{{ section.id }} .striphint { display:none; font-size:11px; color:var(--paper-3); text-align:center; margin-top:10px; }

@media(max-width:760px){
  #shopify-section-{{ section.id }} .stripwrap { overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; scrollbar-width:none; margin:6px -14px 0; padding:0 14px 6px; }
  #shopify-section-{{ section.id }} .stripwrap::-webkit-scrollbar { display:none; }
  #shopify-section-{{ section.id }} .rangerow { min-height:132px; justify-content:flex-start; gap:10px; }
  #shopify-section-{{ section.id }} .rangerow .pimg { height:116px; }
  #shopify-section-{{ section.id }} .rangerow .pimg:nth-child(even) { height:104px; }
  #shopify-section-{{ section.id }} .striphint { display:block; }
  #shopify-section-{{ section.id }} .range-head { gap:10px; }
}

/* Entrance Animation Setup */
#shopify-section-{{ section.id }} .rv { opacity:0; transform:translateY(30px); filter:blur(7px); transition:opacity .95s var(--ease),transform .95s var(--ease),filter .95s var(--ease); }
#shopify-section-{{ section.id }} .rv.in { opacity:1; transform:none; filter:none; }
</style>

<section class="sec" id="range-{{ section.id }}">
  <div class="wrap">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          <span class="kicker">{{ section.settings.kicker }}</span>
          <h2 class="d2" style="margin-top:10px">{{ section.settings.heading }}</h2>
        </div>
        <p class="body-s">{{ section.settings.subheading }}</p>
      </div>
      <div class="stripwrap">
        <div class="rangerow">
          <span class="pimg p-floor" role="img" aria-label="Purelane natural herbal floor cleaner"></span>
          <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span>
          <span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span>
          <span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span>
          <span class="pimg p-laundry" role="img" aria-label="Purelane natural laundry detergent"></span>
          <span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel"></span>
          <span class="pimg p-metal" role="img" aria-label="Purelane copper, bronze and brass cleaner"></span>
          <span class="pimg p-wm" role="img" aria-label="Purelane washing machine cleaner and descaler"></span>
          <span class="pimg p-handwash" role="img" aria-label="Purelane gentle hydrating liquid handwash"></span>
          <span class="pimg p-eraser" role="img" aria-label="Purelane magic eraser"></span>
        </div>
      </div>
      <p class="striphint">Swipe to see the full shelf</p>
    </div>
  </div>
</section>

<!-- Scroll Animation Script -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    var revs = document.querySelectorAll('#range-{{ section.id }} .rv');
    if ('IntersectionObserver' in window) {
      var ro = new IntersectionObserver(function (es) {
        es.forEach(function (e) { 
          if (e.isIntersecting) { 
            e.target.classList.add('in'); 
            ro.unobserve(e.target); 
          } 
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
      revs.forEach(function (el) { ro.observe(el); });
    } else {
      revs.forEach(function (el) { el.classList.add('in'); });
    }
  });
</script>

{% schema %}
{
  "name": "Purelane Full Range",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    }
  ],
  "presets": [
    {
      "name": "Purelane Full Range"
    }
  ]
}
{% endschema %}
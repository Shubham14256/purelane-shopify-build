<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

#shopify-section-{{ section.id }} {
  --ink:#f4f0fb; 
  --brand:#4b3a8f; 
  --paper:#241a3d; 
  --paper-2:rgba(36,26,61,.78);
  --paper-3:rgba(36,26,61,.56); 
  --accent:#b8701c; 
  --surface:#17102b;
  --g-bg:linear-gradient(158deg,rgba(255,255,255,.80),rgba(236,230,247,.56) 58%,rgba(222,212,240,.50));
  --sec-y:34px; 
  --maxw:1180px; 
  --ease:cubic-bezier(.2,.7,.2,1);
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  color: var(--paper);
}

#shopify-section-{{ section.id }} * { box-sizing:border-box; margin:0; padding:0; }
#shopify-section-{{ section.id }} .wrap { max-width:var(--maxw); margin:0 auto; padding:0 18px; }
#shopify-section-{{ section.id }} a { color:inherit; text-decoration:none; }
#shopify-section-{{ section.id }} button { font-family:inherit; cursor:pointer; border:none; background:none; color:inherit; }

#shopify-section-{{ section.id }} .d2 { font-family:'Outfit',sans-serif; text-transform:uppercase; letter-spacing:-.018em; font-weight:800; font-size:clamp(30px,4.6vw,54px); line-height:.94; color:var(--surface); }
#shopify-section-{{ section.id }} .kicker { font-size:11px; font-weight:700; letter-spacing:.22em; text-transform:uppercase; color:var(--paper-3); }

#shopify-section-{{ section.id }} .sec { position:relative; padding:var(--sec-y) 0; }
#shopify-section-{{ section.id }} .panel-head { text-align:center; margin-bottom:26px; }
#shopify-section-{{ section.id }} .panel-head .rule { display:flex; align-items:center; gap:13px; margin:0 auto; justify-content:center; max-width:240px; }
#shopify-section-{{ section.id }} .panel-head .rule i { height:1px; flex:1; background:linear-gradient(90deg,rgba(75,58,143,.34),transparent); }
#shopify-section-{{ section.id }} .panel-head .rule i:first-child { background:linear-gradient(90deg,transparent,rgba(75,58,143,.34)); }
#shopify-section-{{ section.id }} .panel-head .rule svg { width:16px; height:16px; color:var(--accent); flex:0 0 auto; }

/* Shelf & Cards */
#shopify-section-{{ section.id }} .shelf { display:grid; gap:14px; grid-template-columns:repeat(2,1fr); }
@media(min-width:860px){ #shopify-section-{{ section.id }} .shelf { grid-template-columns:repeat(4,1fr); } }

#shopify-section-{{ section.id }} .glass { background:var(--g-bg); backdrop-filter:blur(24px) saturate(150%); border:1px solid rgba(75,58,143,.16); border-radius:26px; box-shadow:0 22px 54px rgba(58,44,112,.13), inset 0 1px 0 rgba(255,255,255,.92); position:relative; overflow:hidden; }
#shopify-section-{{ section.id }} .card { padding:16px; display:flex; flex-direction:column; transition:.4s var(--ease); }
#shopify-section-{{ section.id }} .card:hover { transform:translateY(-5px); }

#shopify-section-{{ section.id }} .card .shot { height:150px; border-radius:14px; margin-bottom:14px; display:grid; place-items:center; position:relative; overflow:hidden; background:linear-gradient(160deg,rgba(255,255,255,.60),rgba(236,230,247,.42)); border:1px solid rgba(75,58,143,.10); }

/* SVG Styling */
#shopify-section-{{ section.id }} .pimg-svg { height:122px; width:auto; filter:drop-shadow(0 8px 13px rgba(0,74,66,.13)); }

#shopify-section-{{ section.id }} .card .pill { position:absolute; top:9px; left:9px; font-size:8.5px; font-weight:800; letter-spacing:.13em; text-transform:uppercase; padding:4px 9px; border-radius:999px; background:rgba(255,255,255,.86); border:1px solid rgba(201,118,29,.34); color:#4f7d10; z-index:2; }
#shopify-section-{{ section.id }} .card .pill.sold-out { border-color: red; color: red; }

#shopify-section-{{ section.id }} .card h4 { font-family:'Outfit',sans-serif; font-size:13.5px; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:var(--surface); line-height:1.2; margin-bottom:7px; }
#shopify-section-{{ section.id }} .card .rate { font-size:11.5px; color:var(--paper-2); margin-bottom:10px; display:flex; align-items:center; gap:5px; }
#shopify-section-{{ section.id }} .card .rate b { color:#4f7d10; font-weight:700; }

#shopify-section-{{ section.id }} .card .pr { margin-top:auto; display:flex; align-items:baseline; gap:8px; margin-bottom:12px; }
#shopify-section-{{ section.id }} .card .pr strong { font-family:'Outfit',sans-serif; font-size:18px; color:var(--surface); font-weight:700; }
#shopify-section-{{ section.id }} .card .pr s { font-size:12px; color:var(--paper-3); }
#shopify-section-{{ section.id }} .card .pr em { font-style:normal; font-size:10px; font-weight:800; letter-spacing:.08em; color:#4f7d10; padding:3px 8px; border-radius:999px; background:rgba(201,118,29,.16); border:1px solid rgba(201,118,29,.36); }

#shopify-section-{{ section.id }} .btn { display:inline-flex; align-items:center; gap:10px; height:46px; padding:0 22px; border-radius:999px; font-size:12.5px; font-weight:700; letter-spacing:.13em; text-transform:uppercase; transition:.35s var(--ease); white-space:nowrap; width:100%; justify-content:center; }
#shopify-section-{{ section.id }} .btn-sm { height:38px; padding:0 18px; font-size:11px; letter-spacing:.14em; }
#shopify-section-{{ section.id }} .btn-ghost { background:rgba(255,255,255,.66); border:1px solid rgba(75,58,143,.22); color:#01423b; }
#shopify-section-{{ section.id }} .btn-ghost:hover { background:rgba(255,255,255,.9); transform:translateY(-2px); }
#shopify-section-{{ section.id }} .btn-ghost:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

#shopify-section-{{ section.id }} .rv { opacity:1; transform:none; filter:none; }
</style>


<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

#shopify-section-{{ section.id }} {
  --ink:#f4f0fb; --brand:#4b3a8f; --paper:#241a3d; --paper-2:rgba(36,26,61,.78);
  --paper-3:rgba(36,26,61,.56); --accent:#b8701c; --surface:#17102b;
  --sec-y:34px; --maxw:1180px; --ease:cubic-bezier(.2,.7,.2,1);
  --g-bg:linear-gradient(158deg,rgba(255,255,255,.80),rgba(236,230,247,.56) 58%,rgba(222,212,240,.50));
  --g-inset:inset 0 1px 0 rgba(255,255,255,.92);
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}
#shopify-section-{{ section.id }} * { box-sizing:border-box; margin:0; padding:0; }
#shopify-section-{{ section.id }} .wrap { max-width:var(--maxw); margin:0 auto; padding:0 18px; }
#shopify-section-{{ section.id }} a { color:inherit; text-decoration:none; }

#shopify-section-{{ section.id }} .sec { position:relative; padding:var(--sec-y) 0; }
#shopify-section-{{ section.id }} .d3 { font-family:'Outfit',system-ui,sans-serif; text-transform:uppercase; letter-spacing:-.018em; font-weight:800; font-size:clamp(21px,2.5vw,30px); line-height:1.04; color:var(--surface); margin-bottom:11px; }
#shopify-section-{{ section.id }} .body-s { font-size:14.5px; color:var(--paper-2); line-height:1.66; }

#shopify-section-{{ section.id }} .glass { background:var(--g-bg); backdrop-filter:blur(24px) saturate(150%); border:1px solid rgba(75,58,143,.16); border-radius:26px; box-shadow:0 22px 54px rgba(58,44,112,.13), var(--g-inset); position:relative; overflow:hidden; }

/* Pillars Grid */
#shopify-section-{{ section.id }} .pillars { display:grid; gap:16px; grid-template-columns:1fr; }
@media(min-width:820px){ #shopify-section-{{ section.id }} .pillars { grid-template-columns:repeat(3,1fr); } }

#shopify-section-{{ section.id }} .pillar { padding:26px 24px 24px; display:flex; flex-direction:column; }
#shopify-section-{{ section.id }} .pillar .pi { width:50px; height:50px; border-radius:15px; display:grid; place-items:center; margin-bottom:16px; background:linear-gradient(150deg,rgba(201,118,29,.18),rgba(75,58,143,.12)); border:1px solid rgba(75,58,143,.16); color:#4f7d10; }
#shopify-section-{{ section.id }} .pillar .pi svg { width:24px; height:24px; }
#shopify-section-{{ section.id }} .pillar p { margin-bottom:20px; flex:1; }
#shopify-section-{{ section.id }} .pillar .btn-sm { align-self:flex-start; }

#shopify-section-{{ section.id }} .btn-sm { display:inline-flex; align-items:center; gap:10px; height:38px; padding:0 18px; border-radius:999px; font-size:11px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; transition:.35s var(--ease); white-space:nowrap; }
#shopify-section-{{ section.id }} .btn-ghost { background:rgba(255,255,255,.66); border:1px solid rgba(75,58,143,.22); color:#01423b; }
#shopify-section-{{ section.id }} .btn-ghost:hover { background:rgba(255,255,255,.9); transform:translateY(-2px); }

#shopify-section-{{ section.id }} .rv { opacity:1; transform:none; filter:none; }
</style>

<section class="sec" id="how-{{ section.id }}">
  <div class="wrap">
    <div class="pillars">
      {%- for block in section.blocks -%}
        <article class="glass pillar rv" {{ block.shopify_attributes }}>
          <span class="pi">
            {%- if block.settings.icon_svg != blank -%}
              {{ block.settings.icon_svg }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16.4" cy="6.6" r="2.2"/><circle cx="15" cy="13" r="2.8"/><circle cx="8.6" cy="15.6" r="2.1"/><path d="M4 21h16"/></svg>
            {%- endif -%}
          </span>
          <h3 class="d3">{{ block.settings.title }}</h3>
          <p class="body-s">{{ block.settings.text }}</p>
          {%- if block.settings.btn_text != blank -%}
            <a class="btn-ghost btn-sm" href="{{ block.settings.btn_link }}">{{ block.settings.btn_text }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Pillars",
  "settings": [],
  "blocks": [
    {
      "type": "pillar",
      "name": "Feature Pillar",
      "limit": 3,
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG Code"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Less scrubbing"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Less scrubbing",
            "text": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8\" cy=\"8.5\" r=\"3.2\"/><circle cx=\"16.4\" cy=\"6.6\" r=\"2.2\"/><circle cx=\"15\" cy=\"13\" r=\"2.8\"/><circle cx=\"8.6\" cy=\"15.6\" r=\"2.1\"/><path d=\"M4 21h16\"/></svg>"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Clean ingredients",
            "text": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z\"/><path d=\"m9 12 2.2 2.2L15.4 10\"/></svg>"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Safe around everyone",
            "text": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z\"/></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
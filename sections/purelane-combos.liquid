<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

#shopify-section-{{ section.id }} {
  --ink:#f4f0fb; --brand:#4b3a8f; --paper:#241a3d; --paper-2:rgba(36,26,61,.78);
  --paper-3:rgba(36,26,61,.56); --accent:#b8701c; --accent-2:#c9761d; --surface:#17102b;
  --g-bg:linear-gradient(158deg,rgba(255,255,255,.80),rgba(236,230,247,.56) 58%,rgba(222,212,240,.50));
  --g-inset:inset 0 1px 0 rgba(255,255,255,.92);
  --sec-y:34px; --maxw:1180px; --ease:cubic-bezier(.2,.7,.2,1);
  font-family: 'Inter', system-ui, -apple-system, sans-serif;

  /* BASE64 IMAGES EXACTLY AS ORIGINAL */
  --p-dish:url("data:image/svg+xml;base64,");
  --p-eraser:url("data:image/svg+xml;base64,");
  --p-floor:url("data:image/svg+xml;base64,");
  --p-handwash:url("data:image/svg+xml;base64,");
  --p-kitchen:url("data:image/svg+xml;base64,");
  --p-laundry:url("data:image/svg+xml;base64,");
  --p-tap:url("data:image/svg+xml;base64,");
  --p-toilet:url("data:image/svg+xml;base64,");
  --p-wm:url("data:image/svg+xml;base64,");
}

#shopify-section-{{ section.id }} * { box-sizing:border-box; margin:0; padding:0; }
#shopify-section-{{ section.id }} .wrap { max-width:var(--maxw); margin:0 auto; padding:0 18px; }
#shopify-section-{{ section.id }} a { color:inherit; text-decoration:none; }
#shopify-section-{{ section.id }} .d2 { font-family:'Outfit',sans-serif; text-transform:uppercase; letter-spacing:-.018em; font-weight:800; font-size:clamp(30px,4.6vw,54px); line-height:.94; color:var(--surface); }
#shopify-section-{{ section.id }} .lede { font-size:clamp(15px,1.35vw,17.5px); color:var(--paper-2); max-width:44ch; }
#shopify-section-{{ section.id }} .kicker { font-size:11px; font-weight:700; letter-spacing:.22em; text-transform:uppercase; color:var(--paper-3); }

#shopify-section-{{ section.id }} .sec { position:relative; padding:var(--sec-y) 0; }
#shopify-section-{{ section.id }} .panel-head { text-align:center; margin-bottom:26px; }
#shopify-section-{{ section.id }} .panel-head .rule { display:flex; align-items:center; gap:13px; margin:0 auto; justify-content:center; max-width:240px; }
#shopify-section-{{ section.id }} .panel-head .rule i { height:1px; flex:1; background:linear-gradient(90deg,transparent,rgba(75,58,143,.34)); }
#shopify-section-{{ section.id }} .panel-head .rule svg { width:16px; height:16px; color:var(--accent); flex:0 0 auto; }

/* Combos Horizontal Rail */
#shopify-section-{{ section.id }} .comborail { display:flex; gap:14px; overflow-x:auto; overflow-y:hidden; scroll-snap-type:x mandatory; margin:0 -18px; padding:4px 18px 14px; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
#shopify-section-{{ section.id }} .comborail::-webkit-scrollbar { display:none; }

#shopify-section-{{ section.id }} .glass { background:var(--g-bg); backdrop-filter:blur(24px) saturate(150%); border:1px solid rgba(75,58,143,.16); border-radius:26px; box-shadow:0 22px 54px rgba(58,44,112,.13), inset 0 1px 0 rgba(255,255,255,.92); position:relative; overflow:hidden; }
#shopify-section-{{ section.id }} .combo { flex:0 0 302px; scroll-snap-align:start; display:flex; flex-direction:column; padding:0; transition:.4s var(--ease); }
#shopify-section-{{ section.id }} .combo:hover { transform:translateY(-5px); }
#shopify-section-{{ section.id }} .combo.hero-combo { border-color:rgba(201,118,29,.46); box-shadow:0 22px 54px rgba(58,44,112,.14), 0 0 0 1px rgba(201,118,29,.24), inset 0 1px 0 rgba(255,255,255,.92); }

#shopify-section-{{ section.id }} .combo .tray { padding:14px 14px 13px; border-bottom:1px solid rgba(75,58,143,.12); position:relative; background:linear-gradient(162deg,rgba(255,255,255,.56),rgba(236,230,247,.34)); }
#shopify-section-{{ section.id }} .combo .save { display:inline-block; font-size:9.5px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; padding:5px 11px; border-radius:999px; background:rgba(255,255,255,.84); border:1px solid rgba(201,118,29,.34); color:#4f7d10; margin-bottom:13px; }
#shopify-section-{{ section.id }} .combo .flag { position:absolute; top:14px; right:14px; font-size:8.6px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; padding:5px 10px; border-radius:999px; background:linear-gradient(135deg,#00706a,#004b46); color:#f4fdf6; }

/* Stack inside Combos */
#shopify-section-{{ section.id }} .stack { display:flex; align-items:flex-end; gap:3px; }
#shopify-section-{{ section.id }} .stack .it { flex:1 1 0; min-width:0; text-align:center; }
#shopify-section-{{ section.id }} .stack .it .tile { height:66px; width:44px; margin:0 auto 8px; display:grid; place-items:center; border-radius:9px; background:rgba(255,255,255,.5); border:1px dashed rgba(75,58,143,.26); color:#4f7d10; }
#shopify-section-{{ section.id }} .stack .it .tile svg { width:17px; height:17px; }
#shopify-section-{{ section.id }} .stack .it span { display:block; font-size:8.6px; line-height:1.32; color:var(--paper-2); font-weight:600; }
#shopify-section-{{ section.id }} .stack .plus { flex:0 0 9px; color:var(--accent); font-weight:800; font-size:12px; padding-bottom:30px; text-align:center; }

/* Image Base64 Rendering classes */
#shopify-section-{{ section.id }} .pimg { display:block; background-repeat:no-repeat; background-position:center bottom; background-size:contain; flex:0 0 auto; height:66px; margin:0 auto 8px; filter:drop-shadow(0 5px 8px rgba(0,74,66,.13)); }
#shopify-section-{{ section.id }} .p-dish { background-image:var(--p-dish); aspect-ratio:0.624; }
#shopify-section-{{ section.id }} .p-eraser { background-image:var(--p-eraser); aspect-ratio:1.3187; }
#shopify-section-{{ section.id }} .p-floor { background-image:var(--p-floor); aspect-ratio:0.6312; }
#shopify-section-{{ section.id }} .p-handwash { background-image:var(--p-handwash); aspect-ratio:0.7453; }
#shopify-section-{{ section.id }} .p-kitchen { background-image:var(--p-kitchen); aspect-ratio:0.6387; }
#shopify-section-{{ section.id }} .p-laundry { background-image:var(--p-laundry); aspect-ratio:0.6302; }
#shopify-section-{{ section.id }} .p-tap { background-image:var(--p-tap); aspect-ratio:0.6387; }
#shopify-section-{{ section.id }} .p-toilet { background-image:var(--p-toilet); aspect-ratio:0.6139; }
#shopify-section-{{ section.id }} .p-wm { background-image:var(--p-wm); aspect-ratio:0.6148; }

#shopify-section-{{ section.id }} .combo .body { padding:15px 16px 18px; display:flex; flex-direction:column; flex:1; }
#shopify-section-{{ section.id }} .combo .body h3 { font-family:'Outfit',sans-serif; font-size:16px; font-weight:700; text-transform:uppercase; letter-spacing:-.005em; line-height:1.1; color:var(--surface); }
#shopify-section-{{ section.id }} .combo .cnt { font-size:10.5px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--paper-3); margin-top:6px; }
#shopify-section-{{ section.id }} .combo .inc { font-size:12.4px; color:var(--paper-2); line-height:1.55; margin:11px 0 14px; flex:1; }

#shopify-section-{{ section.id }} .combo .prow { display:flex; align-items:baseline; gap:9px; flex-wrap:wrap; margin-bottom:6px; }
#shopify-section-{{ section.id }} .combo .prow strong { font-family:'Outfit',sans-serif; font-size:25px; font-weight:800; color:var(--surface); letter-spacing:-.02em; }
#shopify-section-{{ section.id }} .combo .prow s { font-size:13px; color:var(--paper-3); }
#shopify-section-{{ section.id }} .combo .prow em { font-style:normal; font-size:9.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; padding:3px 8px; border-radius:999px; background:rgba(201,118,29,.14); border:1px solid rgba(201,118,29,.34); color:#4f7d10; }
#shopify-section-{{ section.id }} .combo .fine { font-size:10.4px; color:var(--paper-3); margin-bottom:14px; }

#shopify-section-{{ section.id }} .btn { display:inline-flex; align-items:center; gap:10px; height:46px; padding:0 22px; border-radius:999px; font-size:12.5px; font-weight:700; letter-spacing:.13em; text-transform:uppercase; transition:.35s var(--ease); white-space:nowrap; width:100%; justify-content:center; }
#shopify-section-{{ section.id }} .btn-primary { background:linear-gradient(135deg,#00706a,#004b46); color:#f4fdf6; box-shadow:0 12px 26px rgba(0,80,74,.26); }
#shopify-section-{{ section.id }} .btn-ghost { background:rgba(255,255,255,.66); border:1px solid rgba(75,58,143,.22); color:#01423b; }
#shopify-section-{{ section.id }} .btn-ghost:hover, #shopify-section-{{ section.id }} .btn-primary:hover { transform:translateY(-2px); }

#shopify-section-{{ section.id }} .swipecue { display:flex; align-items:center; justify-content:center; gap:8px; font-size:10px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--paper-3); margin-top:2px; }
#shopify-section-{{ section.id }} .swipecue svg { width:14px; height:14px; color:var(--accent); }
#shopify-section-{{ section.id }} .railnote { text-align:center; font-size:12px; color:var(--paper-3); margin-top:14px; max-width:62ch; margin-left:auto; margin-right:auto; }

#shopify-section-{{ section.id }} .rv { opacity:1; transform:none; filter:none; }
</style>

<section class="sec" id="combos-{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
    </div>

    <div class="comborail rv">
      {%- if section.settings.use_original_cards -%}
        <!-- HARDCODED 5 ORIGINAL COMBOS FOR 100% DESIGN ACCURACY -->
        <article class="glass combo">
          <div class="tray"><span class="save">You save ₹398</span><span class="flag">Most popular</span><div class="stack"><span class="it"><span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span><span>Cuts grease instantly</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel"></span><span>Squeaky clean dishes</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span><span>Melts hard water stains</span></span></div></div>
          <div class="body"><h3>Kitchen essentials</h3><div class="cnt">3 products</div><p class="inc">Includes: Foaming Kitchen Cleaner, Dishwash Gel &amp; Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately.</p><div class="prow"><strong>₹499</strong><s>₹897</s><em>Save ₹398</em></div><div class="fine">Inclusive of all taxes &middot; COD available</div><a class="btn btn-ghost" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a></div>
        </article>

        <article class="glass combo">
          <div class="tray"><span class="save">You save ₹448</span><div class="stack"><span class="it"><span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent"></span><span>Removes tough stains &amp; odour</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span><span>Softens &amp; freshens every wash</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-wm" role="img" aria-label="Purelane washing machine cleaner and descaler tablets"></span><span>Deep-cleans your machine</span></span></div></div>
          <div class="body"><h3>Laundry care bundle</h3><div class="cnt">3 products</div><p class="inc">Includes: Laundry Detergent, Fabric Conditioner &amp; Machine Cleaner Powder. Softer, fresher wash, all in one box.</p><div class="prow"><strong>₹499</strong><s>₹947</s><em>Save ₹448</em></div><div class="fine">Inclusive of all taxes &middot; COD available</div><a class="btn btn-ghost" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a></div>
        </article>

        <article class="glass combo hero-combo">
          <div class="tray"><span class="save">Biggest saving</span><span class="flag">Best value</span><div class="stack"><span class="it"><span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span><span>Cuts grease instantly</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-floor" role="img" aria-label="Purelane natural herbal floor cleaner"></span><span>Kills 99.9% germs</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-handwash" role="img" aria-label="Purelane gentle hydrating liquid handwash"></span><span>Gentle hydration for hands</span></span></div></div>
          <div class="body"><h3>Complete home bundle</h3><div class="cnt">5 products</div><p class="inc">Includes: Kitchen Cleaner, Laundry Detergent, Floor Cleaner, Toilet Cleaner &amp; Handwash. Our biggest saving box.</p><div class="prow"><strong>₹799</strong><s>₹1,495</s><em>Save ₹696</em></div><div class="fine">Inclusive of all taxes &middot; COD available</div><a class="btn btn-primary" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a></div>
        </article>

        <article class="glass combo">
          <div class="tray"><span class="save">You save ₹398</span><div class="stack"><span class="it"><span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span><span>Kills 99.9% germs</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span><span>Melts hard water stains</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-eraser" role="img" aria-label="Purelane magic eraser"></span><span>Scrubs away soap scum</span></span></div></div>
          <div class="body"><h3>Bathroom deep clean</h3><div class="cnt">3 products</div><p class="inc">Includes: Toilet Cleaner, Tap Cleaner &amp; Magic Eraser. A complete bathroom refresh in one box.</p><div class="prow"><strong>₹499</strong><s>₹897</s><em>Save ₹398</em></div><div class="fine">Inclusive of all taxes &middot; COD available</div><a class="btn btn-ghost" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a></div>
        </article>

        <article class="glass combo">
          <div class="tray"><span class="save">You save ₹249</span><div class="stack"><span class="it"><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span><span>Melts hard water stains</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span><span>Fights limescale in the bowl</span></span></div></div>
          <div class="body"><h3>Hard water solution kit</h3><div class="cnt">2 products</div><p class="inc">Includes: Tap Cleaner &amp; Toilet Cleaner. A quick, focused fix for hard water stains across the home.</p><div class="prow"><strong>₹349</strong><s>₹598</s><em>Save ₹249</em></div><div class="fine">Inclusive of all taxes &middot; COD available</div><a class="btn btn-ghost" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a></div>
        </article>
      {%- else -%}
        <!-- DYNAMIC BLOCKS IF MERCHANT UNCHECKS THE BOX -->
        {%- for block in section.blocks -%}
          <!-- Dynamic logic hidden to preserve perfect design -->
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>Swipe for more combos
    </div>
    <p class="railnote">Tapping &quot;Shop bundle&quot; opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos Rail",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "checkbox",
      "id": "use_original_cards",
      "label": "Use Original 5 Cards Design",
      "default": true,
      "info": "Leave this checked to automatically render the original 5 HTML combos perfectly."
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos Rail"
    }
  ]
}
{% endschema %}